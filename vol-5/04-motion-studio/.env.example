# Copy to .env and fill in, or just export it in your shell.
#
# This variable is optional. With it unset, the whole studio still works:
# generate.py composes the animation from the template, critique.py runs its ten
# mechanical checks, and render.py captures the video. That is the default path
# and it is the one the README walks you through.
#
# Only two commands read this key, and only when you pass --ai to them:
#
#   python generate.py brand.json brief.txt --ai
#       sends your brand values and your three lines of brief
#
#   python critique.py out/animation.html --ai
#       sends the generated page source and its timeline
#
# Nothing else is uploaded. No rendered frame and no video file ever leaves the
# machine, in any configuration.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
