# Copy to .env and fill in, or export these in your shell.
# Both variables are optional and both are only read when you pass
# --summary openai. Photos are never sent to OpenAI in any mode.
#
# analyze.py reads these two variables and nothing else.

# Optional. Turns on the phrasing layer for the summary paragraph.
# What is sent: month counts, quiet months, gap length, category totals, and the
# indoor/outdoor split. No image, thumbnail, EXIF, GPS, filename, or file path.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required whenever OPENAI_API_KEY is set and --summary openai is used. There is
# no default, on purpose: model names change and this project will not guess one.
# List what your account can call:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=
