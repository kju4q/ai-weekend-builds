# Copy to .env and fill in, or just export these in your shell.
# Both variables are optional. With neither set, the project runs fully local
# and prints the retrieved passages, which is the default way to use it.
#
# ask.py reads these two variables and nothing else.

# Optional. Turns on the answer-phrasing layer.
# Only the retrieved passages for the current question are sent. Your index,
# your folder, and every passage that was not retrieved stay on your machine.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required whenever OPENAI_API_KEY is set. There is no default, on purpose:
# model names change, and this project will not guess one on your behalf.
# Set it to a chat model your account can call, then confirm with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=
