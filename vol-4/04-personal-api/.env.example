# Personal API configuration.
#
# Copying this file does nothing on its own. The server reads ordinary
# environment variables, so the file has to be sourced or the variables have to
# be exported:
#
#   cp .env.example .env
#   set -a
#   source .env
#   set +a
#   python3 server.py
#
# There is no model key here and no model anywhere in this project.
# There is no HOST variable. The server always binds to 127.0.0.1.

# Where calendar.json, tasks.json, and ideas.jsonl live.
# A --data-dir flag on the command line wins over this.
PERSONAL_API_DATA_DIR=.personal-api-data

# Port to listen on. A --port flag on the command line wins over this.
PERSONAL_API_PORT=8765

# Optional weather lookup. Leave both blank and no weather request is ever made.
# Setting them sends these coordinates to the provider below, which reveals your
# approximate location to that provider. Nothing else is sent: no task, no idea,
# no calendar entry, no filename, no path.
WEATHER_LAT=
WEATHER_LON=

# How long to wait for the weather provider before giving up.
WEATHER_TIMEOUT_SECONDS=5

# The weather endpoint. The default is Open-Meteo, which needs no key.
# Changing this is for controlled local testing, for example pointing it at an
# address that refuses connections to watch the failure path. Only http and
# https are accepted, and it can only be set here, never through a request.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
