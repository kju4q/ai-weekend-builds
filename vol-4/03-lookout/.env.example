# Copy to .env and fill in, or export these in your shell.
# Both variables are optional and both are only read when you pass --judge.
# Fetching, diffing, and the archive never touch them.
#
# check.py reads these two variables and nothing else.

# Optional. Turns on change judgment for a detected diff.
# What is sent: the source name and the unified diff of that one change. Never
# the archive, never a full page, never your other sources.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required whenever you use --judge. There is no default, on purpose: model
# names change and this project will not guess one for you.
# List what your account can call:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=
